# ── Next.js web app env vars ─────────────────────────────────────────────────
# See panorama-client/DEPLOY.md for Vercel deployment instructions

# Supabase — Next.js app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Panorama Rust API — optional (app degrades gracefully without it)
# Set to https://api.panorama.kupuri.app when Rust service is deployed
NEXT_PUBLIC_PANORAMA_API_URL=https://api.panorama.kupuri.app

# Supabase — Rust API (service role, never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Database — Rust API direct connection
DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres

# SYNTHIA bridge (internal)
SYNTHIA_BRIDGE_URL=https://synthia.kupuri.app
SYNTHIA_BRIDGE_TOKEN=sk_...

# Claude API — SYNTHIA chat intent classification (server-side only, never exposed to browser)
ANTHROPIC_API_KEY=sk-ant-...

# Translation — Rust worker
DEEPL_API_KEY=your-deepl-free-or-pro-key

# Vapi — Voice orb (Next.js)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=vapi_...

# Rust API server
PORT=8080
RUST_LOG=info
